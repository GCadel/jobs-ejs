<%- include("partials/head.ejs") %>
  <%- include("partials/header.ejs") %>
    <div style="display: flex; gap: 2rem; align-items: center;">
      <h2>Your Jobs</h2>
      <a href="/jobs/new">New</a>
    </div>
    <% jobs.forEach((job)=> {%>
      <div>
        <h3>
          <%= job.position %>
            [
            <span style=" opacity: 80%;font-style: italic;">
              <%= job.status %>
            </span>]
        </h3>
        <div>
          <span style=" opacity: 80%;">
            <%= job.company %>
          </span>
        </div>


        <form action="/jobs/delete/<%= job._id  %>" method="post">
          <div style="display: flex; justify-content: space-between; max-width: 100px;"> <button>delete</button> <a
              href="/jobs/edit/<%= job._id %>">Edit</a></div>
          <input type="hidden" name="_csrf" value="<%= _csrf %>" />
        </form>
      </div>
      <%}) %>

        <%- include("partials/footer.ejs") %>